{
  "name": "resqiva",
  "version": "0.1.0",
  "private": true,
  "description": "Inventory-grounded meal bundles for surplus food, with PayPal Sandbox checkout.",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "demo:prepare": "docker compose up -d db && prisma generate && prisma migrate deploy && prisma db seed",
    "demo:up": "npm run demo:prepare && next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "e2e:local": "npm run demo:prepare && playwright test",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "smoke:local": "node scripts/smoke-local.mjs",
    "benchmark:optimizer": "node --env-file-if-exists=.env --import tsx scripts/benchmark-optimizer.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "db:push": "prisma db push"
  },
  "dependencies": {
    "@paypal/react-paypal-js": "^10.6.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "next": "^16.4.4",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.4",
    "prisma": "^7.10.1",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
