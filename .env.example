# Copy to .env for local development. Never commit real credentials.
DATABASE_URL=postgresql://resqiva:resqiva@localhost:5432/resqiva?schema=public
SESSION_SECRET=replace-with-a-random-32-byte-or-longer-secret
ENABLE_DEMO_LOGIN=true

# AI preference parser. There is no alternate model or provider fallback.
AI_PROVIDER=fireworks
AI_MODEL=accounts/fireworks/models/deepseek-v4p1-flash-1017
FIREWORKS_API_KEY=
NODE_USE_ENV_PROXY=1

# PayPal Sandbox only. Production endpoints are intentionally unsupported.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
